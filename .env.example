# Copy to .env (start scripts do this automatically). Never commit .env.
# Without a key the app runs in offline mode: search + drawing/3D opening, no generated answers.
# Changes here only take effect after restarting the server.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Tried in order when the primary model is overloaded (503/429) or times out.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.1-flash-lite
# Seconds per Gemini request before giving up on that model.
GEMINI_TIMEOUT_S=60
# Whole chat turn: stop trying fallback models after this many seconds.
GEMINI_TURN_BUDGET_S=60
# Thinking effort for chat: minimal | low | medium | high (empty = model default). Lower is faster.
GEMINI_THINKING=low
